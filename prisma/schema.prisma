generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Listing {
  id            String    @id @default(cuid())
  handle        String    @unique
  name          String
  oneLine       String    @map("one_line")
  link          String
  linkKey       String    @unique @map("link_key")
  iconUrl       String?   @map("icon_url")
  contactEmail  String    @map("contact_email")
  categorySlug  String    @map("category_slug")
  availableFrom DateTime  @map("available_from") @db.Date
  capacity      String
  lastValue     Decimal   @map("last_value") @db.Decimal(12, 2)
  lastPaidAt    DateTime  @map("last_paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  payments      Payment[]

  @@index([categorySlug])
  @@index([lastPaidAt])
  @@map("listing")
}

model Payment {
  id          String   @id @default(cuid())
  listingId   String   @map("listing_id")
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  stripeId    String   @unique @map("stripe_id")
  valueBefore Decimal  @map("value_before") @db.Decimal(12, 2)
  valueAfter  Decimal  @map("value_after") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("payment")
}
